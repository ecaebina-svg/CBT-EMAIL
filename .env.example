APP_NAME=CBT_APP
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_PORT=3000

# ===== DATABASE CONFIGURATION =====
# Untuk production (Railway/TiDB Cloud), gunakan DATABASE_URL
# Untuk development lokal, gunakan DB_* variables di bawah
DATABASE_URL=mysql://username:password@host:4000/database_name?ssl={"rejectUnauthorized":true}

# Konfigurasi untuk development lokal (XAMPP/Laragon)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cbt_db
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=change_this_secret_key_for_local_learning
JWT_EXPIRES_IN=1d
TIMEZONE=Asia/Jakarta

# ===== EMAIL (SMTP) CONFIG =====
# Pilih: mailtrap (untuk testing) atau gmail (untuk production)
MAIL_DRIVER=smtp

# --- Opsi 1: Mailtrap (Development/Testing) ---
# Daftar gratis di https://mailtrap.io
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_ENCRYPTION=tls

# --- Opsi 2: Gmail SMTP (Production) ---
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=your_app_password
# MAIL_ENCRYPTION=tls

MAIL_FROM_ADDRESS=noreply@cbtapp.com
MAIL_FROM_NAME=CBT App